# OSTRAL — Lot B : F02 — WAF (Z2) -> boutique (Z1) en HTTP sur z1_cloud (TLS terminé au WAF).
# $ostral_boutique est défini dans le server (variable => résolution DNS à la requête :
# nginx démarre même si la boutique n'existe pas encore ; réponse 502 en attendant).
proxy_pass $ostral_boutique;
proxy_http_version 1.1;
proxy_set_header Connection "";

# En-têtes de contexte. X-Forwarded-For est ÉCRASÉ (et non complété) avec l'IP vue par le
# WAF : le WAF est le seul point d'entrée (F01), une valeur envoyée par le client ne doit
# pas être crue (usurpation d'IP => contournement de la limitation de débit côté boutique).
proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $remote_addr;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-Forwarded-Host  $host;
proxy_set_header X-Forwarded-Port  443;
proxy_set_header X-Request-ID      $request_id;
# httpoxy : ne jamais transmettre un en-tête Proxy
proxy_set_header Proxy "";

# Timeouts courts (SS4)
proxy_connect_timeout 5s;
proxy_send_timeout    15s;
proxy_read_timeout    30s;
proxy_next_upstream   off;

# Tampons en mémoire uniquement : aucune réponse écrite sur disque en DMZ
proxy_buffering on;
proxy_buffer_size 16k;
proxy_buffers 16 16k;
proxy_max_temp_file_size 0;
proxy_redirect off;

proxy_hide_header X-Powered-By;
