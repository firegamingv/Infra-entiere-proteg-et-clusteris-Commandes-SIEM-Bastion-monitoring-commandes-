# OSTRAL — Lot B : paramètres TLS communs (E03 : TLS sur tous les flux exposés)
# TLS 1.2 / 1.3 uniquement, suites AEAD à confidentialité persistante (profil Mozilla
# « intermediate »), pas de tickets de session (clé de ticket non renouvelée sinon).
ssl_protocols TLSv1.2 TLSv1.3;
ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
ssl_prefer_server_ciphers off;
ssl_ecdh_curve X25519:prime256v1:secp384r1;
ssl_session_timeout 1h;
ssl_session_cache shared:OSTRAL_TLS:10m;
ssl_session_tickets off;
# AC interne sans répondeur OCSP : agrafage désactivé (évite des avertissements inutiles)
ssl_stapling off;
