# OSTRAL — fichier d'environnement de la maquette (généré par concaténation de env/*.env.example)
# Copier en .env (jamais versionné), puis remplacer chaque CHANGEME (ex. : openssl rand -hex 24).
# Les mots de passe AD doivent respecter la complexité du domaine (12 car., 3 classes) ; éviter le caractère $.

# --- Fusion des fragments compose (le répertoire de projet est la racine) ---
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:compose/z1-boutique.yml:compose/z2-dmz.yml:compose/z3-z5-erp-ad.yml:compose/z6-admin.yml:compose/z7-supervision.yml:compose/z8-postes.yml
# Profils : vide = version légère ; 'siem' ajoute Wazuh (~4,5 Go RAM) ; 'demo' ajoute l'accès local au bastion
COMPOSE_PROFILES=

##############################################################################
# --- env\a-boutique.env.example ---
##############################################################################
# ---------------------------------------------------------------------------
# Lot A — Boutique (Z1) : boutique, boutique-db, psp-mock
# Remplacer toutes les valeurs CHANGEME_ (la boutique et le PSP refusent de démarrer sinon).
# Générer un secret : openssl rand -hex 32
# ---------------------------------------------------------------------------

# Base managée de la boutique (PostgreSQL 16, réseau z1_data)
BOUTIQUE_DB_PASSWORD=CHANGEME_boutique_db_password

# Clé HMAC des jetons de session (empreinte stockée en base, cookie HttpOnly+Secure+SameSite)
SESSION_SECRET=CHANGEME_session_secret_64_hex
# Durée de vie d'une session (minutes)
SESSION_TTL_MINUTES=120

# E04 / SS2 : limitation des tentatives de connexion
# Échecs maximum par IP sur la fenêtre, échecs consécutifs avant verrouillage du compte
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_PER_IP=20
LOGIN_MAX_PER_ACCOUNT=5
LOGIN_LOCK_MINUTES=15

# URL publique de la boutique (servie par le WAF, lot B) : sert aux URL de retour du PSP
BOUTIQUE_PUBLIC_URL=https://ostral.local

# E02 / F03 : PSP simulé (psp-mock)
# URL de la page de paiement hébergée vue par le NAVIGATEUR du client (port publié sur l'hôte)
PSP_PUBLIC_URL=http://localhost:4000
# Clé API marchand (boutique -> PSP, création des paiements)
PSP_API_KEY=CHANGEME_psp_api_key
# Secret partagé de signature HMAC-SHA256 des notifications de paiement (PSP -> boutique)
PSP_WEBHOOK_SECRET=CHANGEME_psp_webhook_secret
# Clé API du transporteur simulé (boutique -> /carrier/labels)
CARRIER_API_KEY=CHANGEME_carrier_api_key

# F04 : ERP Odoo via le WAF en mTLS (valeurs partagées avec le lot C)
ODOO_DB=ostral
# Utilisateur technique Odoo dédié à la boutique (moindre privilège)
ODOO_API_USER=api-boutique
# Clé API Odoo de l'utilisateur technique (générée dans Odoo par le lot C)
ODOO_API_KEY=CHANGEME_odoo_api_key

# R2 : intervalle de scrutation de la file d'attente (secondes)
OUTBOX_POLL_SECONDS=10

##############################################################################
# --- env\b-dmz.env.example ---
##############################################################################
# ----------------------------------------------------------------------------
# Lot B — Z2 DMZ : WAF / reverse proxy (compose/z2-dmz.yml)
# Aucun secret ici : les clés TLS sont générées par scripts/gen-certs.sh dans ./certs
# (gitignoré). Toutes les variables ont une valeur par défaut dans le compose.
# ----------------------------------------------------------------------------
# Ports publiés sur l'hôte (F01) : HTTPS et redirection HTTP -> HTTPS
WAF_HTTPS_PORT=443
WAF_HTTP_PORT=80
# OWASP CRS : niveau de paranoïa en blocage (1 = défaut, 2 = plus strict, plus de faux positifs)
WAF_PARANOIA=1
# Seuils d'anomalie (anomaly scoring) : requête bloquée si score >= seuil
WAF_ANOMALY_INBOUND=5
WAF_ANOMALY_OUTBOUND=4
# Méthodes HTTP admises par le CRS sur le site public
WAF_ALLOWED_METHODS="GET HEAD POST OPTIONS"
# E04 / SS2 : tentatives de connexion / création de compte (POST) par IP => 429 au-delà
WAF_AUTH_RATE=10r/m
WAF_AUTH_BURST=5
# SS4 : limite globale par IP et connexions simultanées par IP
WAF_GLOBAL_RATE=20r/s
WAF_GLOBAL_BURST=40
WAF_CONN_PER_IP=30
# Taille maximale d'un corps de requête
WAF_MAX_BODY_SIZE=1m
# HSTS (secondes)
WAF_HSTS_MAX_AGE=31536000

##############################################################################
# --- env\c-erp.env.example ---
##############################################################################
# ---------------------------------------------------------------------------------------------
# OSTRAL — Lot C — ERP Odoo (Z3), base PostgreSQL (Z4), annuaire AD (Z5)
# Valeurs d'exemple : à remplacer dans .env (jamais commité). Générer par ex. :
#   openssl rand -base64 24   (mots de passe)      openssl rand -hex 20   (clé API Odoo)
# Les mots de passe de l'AD doivent respecter la politique du domaine : >= 12 caractères,
# complexité (3 classes parmi majuscules / minuscules / chiffres / symboles).
# Éviter les caractères « $ » (interpolation compose) et les retours à la ligne.
# ---------------------------------------------------------------------------------------------

# --- erp-db (Z4) -----------------------------------------------------------------------------
# Superutilisateur PostgreSQL (administration locale au conteneur uniquement)
ERP_DB_ADMIN_PASSWORD=CHANGEME_erp_db_admin_password
# Compte de service applicatif d'Odoo (F06) — propriétaire de la seule base ostral
ERP_DB_USER=odoo
ERP_DB_PASSWORD=CHANGEME_erp_db_odoo_password
# Rôle lecture seule `backup_ro` utilisé par le lot E (sauvegarde en mode pull, F16/E09)
ERP_DB_BACKUP_PASSWORD=CHANGEME_erp_db_backup_ro_password

# --- odoo (Z3) -------------------------------------------------------------------------------
# Base unique de l'ERP (aussi utilisée par le lot A — ne pas renommer la variable)
# ODOO_DB : déjà défini plus haut (variable partagée)
# Mot de passe maître Odoo (gestionnaire de bases, désactivé par list_db=False) — stocké haché
ODOO_ADMIN_PASSWD=CHANGEME_odoo_master_password
# Mot de passe du compte web « admin » d'Odoo (remplace la valeur par défaut « admin »)
ODOO_WEB_ADMIN_PASSWORD=CHANGEME_Odoo_Web_Admin_2026!
# Utilisateur technique de l'API boutique → ERP et sa clé API (aussi utilisées par le lot A)
# ODOO_API_USER : déjà défini plus haut (variable partagée)
# Clé imposée par odoo-init (>= 20 caractères, sans espace ; recommandé : openssl rand -hex 20)
# ODOO_API_KEY : déjà défini plus haut (variable partagée)
# Nombre de workers HTTP Odoo (2 suffit pour la maquette)
ODOO_WORKERS=2

# --- samba-ad (Z5) ---------------------------------------------------------------------------
# Mot de passe du compte Administrator du domaine OSTRAL.LOCAL (complexité obligatoire)
SAMBA_ADMIN_PASSWORD=CHANGEME_Samba_Admin_2026!
# Compte de liaison LDAP d'Odoo : CN=svc-odoo-ldap,OU=Comptes-Service,OU=OSTRAL,DC=ostral,DC=local
SAMBA_ODOO_BIND_PASSWORD=CHANGEME_Svc_Odoo_Ldap_2026!
# Mot de passe commun des comptes de démonstration (alice.martin, bruno.durand, chloe.petit, adm.claire)
SAMBA_DEMO_USER_PASSWORD=CHANGEME_Demo_User_2026!

##############################################################################
# --- env\d-admin.env.example ---
##############################################################################
# =============================================================================
# OSTRAL — lot D — Administration (Z6) et postes (Z8)
# Valeurs d'EXEMPLE : copier dans .env (gitignoré) et remplacer chaque CHANGEME_ (E12).
# =============================================================================

# --- VPN WireGuard (F09) ------------------------------------------------------
# Adresse (IP ou nom DNS) par laquelle les clients joignent l'hôte Docker en UDP 51820.
# Démo sur un seul PC : IP LAN de l'hôte (ex. 192.168.1.20) ; éviter "auto" (interroge Internet).
WG_SERVERURL=CHANGEME_ip_ou_nom_public_de_l_hote
# Pairs NOMINATIFS (E07) — noms alphanumériques uniquement (contrainte de l'image) :
# "agenceweb" = pair VPN du prestataire, associé au compte bastion "agence-web".
WG_PEERS=admin1,admin2,agenceweb
# Pairs prestataires : accès au bastion SEULEMENT.
WG_RESTRICTED_PEERS=agenceweb
WG_RESTRICTED_DESTS=10.10.6.10:8080
# Destinations des pairs administrateurs : bastion, console Wazuh, Uptime Kuma.
WG_ADMIN_DESTS=10.10.6.10:8080,10.10.7.22:5601,10.10.7.22:443,10.10.7.30:3001

# --- Bastion Guacamole (E06, E07) -------------------------------------------------
# Mot de passe du compte de base PostgreSQL du bastion (guac-db <-> guacamole).
GUAC_DB_PASSWORD=CHANGEME_guac_db_mot_de_passe_long
# Mots de passe INITIAUX (12 caractères min.) ; expirés : changement imposé au 1er login,
# puis enrôlement TOTP obligatoire. Lus seulement à la 1re initialisation de guac-db.
GUAC_ADMIN_PASSWORD=CHANGEME_Admin1-Initial!
GUAC_ADMIN2_PASSWORD=CHANGEME_Admin2-Initial!
GUAC_AGENCE_WEB_PASSWORD=CHANGEME_Agence-Initial!
# Compte prestataire temporaire (E07) : date de fin (AAAA-MM-JJ, future, 90 jours max)
# et fenêtre horaire quotidienne (fuseau OSTRAL_TZ).
AGENCE_WEB_VALID_UNTIL=CHANGEME_2026-12-31
AGENCE_WEB_ACCESS_START=08:00
AGENCE_WEB_ACCESS_END=19:00
OSTRAL_TZ=Europe/Paris
# Type de la clé SSH bastion -> serveurs : ed25519 (défaut) ou rsa (RSA 4096 PEM, repli si
# la version de guacd refusait la clé ED25519).
GUAC_SSH_KEY_TYPE=ed25519

# --- admin-target / sauvegarde (F16) ---------------------------------------------
# Clé PUBLIQUE du service backup (lot E), une ligne. Vide = compte backup-ro inutilisable.
# Elle n'est acceptée que depuis 10.10.3.41, avec commande forcée en lecture seule.
BACKUP_SSH_PUBKEY=

##############################################################################
# --- env\e-supervision.env.example ---
##############################################################################
# ---------------------------------------------------------------------------
# Lot E — Z7 supervision, SIEM, sauvegarde (compose/z7-supervision.yml)
# Valeurs d'exemple : TOUT remplacer dans .env (non versionné, E12).
# ---------------------------------------------------------------------------

# --- Wazuh (profil siem) : comptes LOCAUX du SIEM, indépendants de l'AD (E08) ---
# Compte « admin » de l'indexer (console https://10.10.7.22:5601 + Filebeat du manager)
INDEXER_PASSWORD=CHANGEME_indexer_admin_password
# Compte technique « kibanaserver » du dashboard
DASHBOARD_PASSWORD=CHANGEME_dashboard_kibanaserver_password
# Compte « wazuh-wui » de l'API Wazuh : 8-64 caractères, majuscule, minuscule, chiffre ET symbole
API_PASSWORD=CHANGEME_Api.Wazuh-2026

# --- Sauvegarde (F16, E09) ---
# Phrase de passe du dépôt restic (chiffrement AES-256 côté client, F17).
# À conserver HORS du SI (coffre, enveloppe) : sans elle, aucune restauration possible.
RESTIC_PASSWORD=CHANGEME_restic_repository_passphrase
# Base ERP sauvegardée (même nom que ODOO_DB des lots A/C)
ERP_DB_NAME=ostral
ERP_DB_BACKUP_USER=backup_ro
# ERP_DB_BACKUP_PASSWORD : MÊME variable que le lot C (env/c-erp.env.example), ne pas la dupliquer
# dans .env : le rôle backup_ro est créé par erp-db avec ce mot de passe.
# Compte SSH du pull sur admin-target (commande forcée backup-ro.sh du lot D)
BACKUP_SSH_USER=backup-ro
# BACKUP_SSH_PUBKEY (lot D) : à remplir avec la sortie de
#   docker compose run --rm --no-deps backup show-pubkey
# Seuil du test de restauration mensuel (nombre minimal de tables Odoo restaurées)
RESTORE_MIN_TABLES=50
# Battements « push » Uptime Kuma (jetons des sondes 10 et 11 de services/uptime-kuma/monitors-backup.json)
UPTIME_KUMA_PUSH_HOURLY=http://uptime-kuma:3001/api/push/OstralBackupHourly01
UPTIME_KUMA_PUSH_NIGHTLY=http://uptime-kuma:3001/api/push/OstralBackupNightly01

# --- Stockage objet hors site minio-offsite (F17) ---
MINIO_ROOT_USER=ostral-offsite-root
MINIO_ROOT_PASSWORD=CHANGEME_minio_root_password
# Clé d'accès en ÉCRITURE SEULE du serveur de sauvegarde (PutObject, aucune suppression)
MINIO_BACKUP_ACCESS_KEY=ostral-backup-writer
MINIO_BACKUP_SECRET_KEY=CHANGEME_minio_backup_secret_key
MINIO_OFFSITE_BUCKET=ostral-backup-offsite
# COMPLIANCE (dossier : même un administrateur ne peut pas effacer) ou GOVERNANCE (contournable par root)
MINIO_OFFSITE_RETENTION_MODE=COMPLIANCE
MINIO_OFFSITE_RETENTION_DAYS=30
